# Copy this file to .env and fill in your own values. Never commit .env.
#   cp .env.example .env

# --- Docker: n8n + Postgres (read by docker-compose.yml) ---

# Long random string that encrypts the credentials n8n stores.
# Make one with:  openssl rand -hex 32
# Keep it: if it changes, n8n can no longer read the saved credentials.
N8N_ENCRYPTION_KEY=change-me

# Postgres database used by n8n
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris

# Public address of n8n. Keep localhost for local testing; Telegram and the
# website need a public https address (for example an ngrok domain).
WEBHOOK_URL=http://localhost:5678/

# false lets you sign in over plain http://localhost (needed for Safari).
# Set to true once n8n is served over https.
N8N_SECURE_COOKIE=false

# --- Keys for the bot (entered in n8n under Credentials, not read from this file) ---

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Anthropic: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=replace-me

# Error Handler: your own Telegram chat id (where alerts are sent)
ALERT_CHAT_ID=123456789

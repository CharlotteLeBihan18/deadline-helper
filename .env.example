# Copy this file to .env and fill in your own values. Never commit .env.
# The bot itself does not read these from a file on n8n Cloud: the keys are
# entered once in n8n under Credentials. They are listed here so you know
# what you need, and for self-hosting n8n.

# n8n (self-hosting only)
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris
WEBHOOK_URL=https://your-public-n8n-address/

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Anthropic: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=replace-me

# Error Handler: your own Telegram chat id (where alerts are sent)
ALERT_CHAT_ID=123456789

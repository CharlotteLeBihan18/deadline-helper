    {
      "parameters": {
        "jsCode": "// Read the website's request and decide what to do.\nlet b = $input.first().json.body || {};\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nconst action = String(b.action || '');\nconst name = (String(b.name || '').trim().slice(0, 60) || 'Web user') + ' (web)';\n\nif (action === 'list') return [{ json: { action } }];\n\nif (action === 'add') {\n  const text = String(b.text || '').trim().slice(0, 4000);\n  if (!text) return [{ json: { action: 'invalid', error: 'Please type a deadline first.' } }];\n  return [{ json: { action, text, added_by: name, source: 'web' } }];\n}\n\nif (action === 'delete') {\n  const id = parseInt(b.id, 10);\n  if (!Number.isInteger(id) || id <= 0) return [{ json: { action: 'invalid', error: 'Unknown deadline.' } }];\n  return [{ json: { action, id } }];\n}\n\nif (action === 'add_file') {\n  const mime = String(b.mime || '');\n  const isPdf = mime === 'application/pdf';\n  if (!(isPdf || mime.startsWith('image/')) || !b.data) {\n    return [{ json: { action: 'invalid', error: 'Please upload an image or a PDF.' } }];\n  }\n  const buf = Buffer.from(String(b.data), 'base64');\n  if (buf.length > 10 * 1024 * 1024) return [{ json: { action: 'invalid', error: 'That file is too big (max 10 MB).' } }];\n  const bin = await this.helpers.prepareBinaryData(buf, String(b.filename || (isPdf ? 'upload.pdf' : 'upload.jpg')), mime);\n  return [{\n    json: { action, added_by: name, file_kind: isPdf ? 'pdf' : 'photo', caption: String(b.text || '').trim().slice(0, 500) },\n    binary: { data: bin },\n  }];\n}\n\nreturn [{ json: { action: 'invalid', error: 'Unknown request.' } }];"
      },

    {
      "parameters": {
        "jsCode": "// Shape upcoming deadlines for the website, soonest first.\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id);\nrows.sort((a, b) => new Date(a.due_at) - new Date(b.due_at));\nreturn [{ json: { deadlines: rows.map(r => ({\n  id: r.id, course: r.course, title: r.title, due_at: r.due_at,\n  conflict: !!r.conflict, added_by: r.added_by, source: r.source,\n})) } }];"
      },
